# Database — local Supabase (via `supabase start`)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Remote Supabase (staging / production) — set in CI or override locally to test
# DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres

# Payload
PAYLOAD_SECRET=your-min-32-char-secret-here
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Analytics (PostHog)
# NEXT_PUBLIC_POSTHOG_KEY=
# NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# Phase 4: Apify (Zillow scraper — for pnpm import-address)
# APIFY_TOKEN=apify_api_...

# Import pipeline defaults
# IMPORT_DEFAULT_SOURCES=trulia           # comma-separated, first = highest priority
# IMPORT_DELAY_MS=5000                    # delay between addresses in batch (helps avoid IP blocks)

# LLM — default: Gemini 2.5 Flash (enrich-listing, import-address inference)
# Get API key: https://aistudio.google.com/apikey — usage subject to Google terms/pricing.
GEMINI_API_KEY=
# LLM_PROVIDER=gemini
# LLM_MODEL=gemini-2.5-flash
# LLM_MAX_NEW_TAGS=30
# LLM_MAX_PHOTOS=6

# Optional: local Ollama instead of Gemini
# LLM_PROVIDER=ollama
# LLM_MODEL=llama3.2-vision
# LLM_VISION_MODEL=                    # optional; defaults to LLM_MODEL. Set for two-pass.
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=                          # not needed for local Ollama

# Photo ingest (source feed allowlist)
# PHOTO_SOURCE_ALLOWLIST=zillowstatic.com,photos.zillowstatic.com,media.trulia.com,www.trulia.com

# Media read (our storage; for scripts reading listing photos)
# MEDIA_LOCAL_PATH=                     # local FS path to uploads; else fetch from URL
# MEDIA_STORAGE_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
