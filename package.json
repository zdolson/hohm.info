{
  "name": "hohm-info",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "rm -rf .next && next dev",
    "prepare": "panda codegen --clean && husky",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "format": "prettier --write \"src/**/*.{ts,tsx,json}\"",
    "test": "vitest run --config vitest.config.mts",
    "test:watch": "vitest --config vitest.config.mts",
    "test:e2e": "playwright test",
    "payload:types": "payload generate:types",
    "payload:migrate": "payload migrate",
    "payload:migrate:create": "payload migrate:create",
    "postinstall": "payload generate:types || true",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:status": "supabase status",
    "db:reset": "supabase db reset",
    "import:seed": "tsx scripts/seed.ts",
    "import:csv": "tsx scripts/import-csv.ts",
    "import:address": "tsx scripts/import-address.ts",
    "listing:enrich": "tsx scripts/enrich-listing.ts",
    "listing:apply-tags": "tsx scripts/apply-tags.ts",
    "seed": "pnpm import:seed",
    "import-csv": "pnpm import:csv",
    "import-address": "pnpm import:address",
    "enrich-listing": "pnpm listing:enrich",
    "apply-tags": "pnpm listing:apply-tags",
    "generate:types": "pnpm payload:types",
    "migrate": "pnpm payload:migrate",
    "migrate:create": "pnpm payload:migrate:create"
  },
  "dependencies": {
    "@ark-ui/react": "^5.32.0",
    "openai": "^4.77.0",
    "zod": "^3.24.0",
    "zod-to-json-schema": "^3.24.0",
    "@img/sharp-darwin-arm64": "0.34.5",
    "@img/sharp-libvips-darwin-arm64": "1.2.4",
    "@payloadcms/db-postgres": "^3.0.0",
    "@payloadcms/richtext-lexical": "^3.76.1",
    "@testing-library/react": "^16.3.2",
    "@vitejs/plugin-react": "^5.1.4",
    "cheerio": "^1.2.0",
    "csv-parse": "^6.1.0",
    "graphql": "^16.12.0",
    "jsdom": "^28.1.0",
    "lucide-react": "^0.575.0",
    "next": "15.4.11",
    "payload": "^3.0.0",
    "postcss": "^8.4.49",
    "posthog-js": "^1.194.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "server-only": "^0.0.1",
    "sharp": "^0.34.5",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.0.18"
  },
  "devDependencies": {
    "@pandacss/dev": "^1.8.2",
    "@park-ui/panda-preset": "^0.43.1",
    "@payloadcms/next": "^3.0.0",
    "@playwright/test": "^1.58.2",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^16.4.5",
    "eslint": "^9",
    "eslint-config-next": "^15.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "prettier": "^3.8.1",
    "supabase": "^2.76.12",
    "tsx": "^4.19.2",
    "typescript": "^5"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.{json,md,css,mjs}": [
      "prettier --write"
    ]
  },
  "packageManager": "pnpm@9.15.0",
  "type": "module",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp",
      "supabase"
    ]
  }
}
